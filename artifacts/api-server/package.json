{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "drizzle:status": "drizzle-kit status --config ./drizzle.config.ts",
    "drizzle:migrate:generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "drizzle:migrate": "echo 'Drizzle migrations are disabled by default. Use drizzle-kit with a configured DATABASE_URL to apply.'"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.390.0",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.10.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.17",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.5.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
